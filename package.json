{
  "name": "butor",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Butor — browser-based 3D wardrobe designer (v2).",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build",
    "build:test": "vite build --mode test",
    "start": "NODE_ENV=production tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise src server --config .dependency-cruiser.cjs && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^1.15.0",
    "hono": "^4.8.4",
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0",
    "tsx": "^4.20.3",
    "zod": "^4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
